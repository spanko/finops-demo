<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ client_name }} — FinOps Findings</title>
<style>
  :root {
    --purple-dark: #3A1D5C;
    --purple: #582C83;
    --purple-lt: #9581B2;
    --purple-soft: #E8E2F0;
    --orange: #F26B23;
    --teal: #00838F;
    --text-dark: #1A1A1A;
    --text-body: #333333;
    --text-muted: #767676;
    --line: #D1D1D1;
    --bg: #F7F5FA;
  }
  * { box-sizing: border-box; }
  body {
    font-family: Arial, Helvetica, sans-serif;
    color: var(--text-body);
    margin: 0;
    background: #FFFFFF;
  }
  header {
    background: var(--purple-dark);
    color: #FFFFFF;
    padding: 36px 56px 28px 56px;
    border-bottom: 6px solid var(--orange);
  }
  header .kicker {
    color: var(--purple-lt);
    font-weight: bold;
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  header h1 {
    margin: 0 0 8px 0;
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.5px;
  }
  header .subtitle {
    color: #CBC0D8;
    font-size: 15px;
  }
  main { padding: 32px 56px 64px 56px; max-width: 1200px; }
  h2 {
    color: var(--purple);
    font-size: 22px;
    margin: 40px 0 16px 0;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--purple-soft);
  }
  h3 {
    color: var(--text-dark);
    font-size: 15px;
    margin: 20px 0 12px 0;
  }
  .headline-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 24px 0 8px 0;
  }
  .stat-card {
    background: var(--bg);
    border-left: 5px solid var(--purple);
    padding: 20px 24px;
    border-radius: 2px;
  }
  .stat-card.orange { border-left-color: var(--orange); }
  .stat-card.teal { border-left-color: var(--teal); }
  .stat-label {
    font-size: 10px;
    font-weight: bold;
    color: var(--purple);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 6px;
  }
  .stat-value {
    font-size: 34px;
    font-weight: 700;
    color: var(--text-dark);
    line-height: 1;
  }
  .stat-sub {
    color: var(--text-muted);
    font-size: 12px;
    margin-top: 6px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 12px 0 24px 0;
    font-size: 13px;
  }
  thead th {
    background: var(--purple);
    color: #FFFFFF;
    text-align: left;
    padding: 10px 14px;
    font-weight: 600;
    letter-spacing: 0.3px;
  }
  tbody tr:nth-child(even) { background: #FAFAFA; }
  tbody td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pill {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 600;
  }
  .pill.high { background: #DDF5E0; color: #175B28; }
  .pill.medium { background: #FDF1D9; color: #8C5A00; }
  .pill.low { background: #F3E1E1; color: #7A1F1F; }
  .pill.m365 { background: #E8E2F0; color: #582C83; }
  .pill.security { background: #EAE4F2; color: #6D4D92; }
  .pill.commitments { background: #CCE6E9; color: #00838F; }
  .pill.waste { background: #FFE5D2; color: #B54A10; }
  .callout {
    background: var(--purple-soft);
    border-left: 4px solid var(--purple);
    padding: 14px 20px;
    margin: 20px 0;
    border-radius: 2px;
  }
  .callout .callout-label {
    font-size: 10px;
    font-weight: bold;
    color: var(--purple);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 4px;
  }
  .callout .callout-body { color: var(--text-dark); font-size: 13px; }
  footer {
    padding: 24px 56px;
    color: var(--text-muted);
    font-size: 11px;
    border-top: 1px solid var(--line);
  }
  .recipe-section { margin-bottom: 24px; }
  .recipe-section summary {
    cursor: pointer;
    padding: 12px 18px;
    background: var(--bg);
    border-left: 4px solid var(--purple-lt);
    font-weight: 600;
    color: var(--text-dark);
    font-size: 14px;
  }
  .recipe-section summary:hover { background: var(--purple-soft); }
  .recipe-section .recipe-stats {
    display: inline-block;
    margin-left: 18px;
    color: var(--text-muted);
    font-weight: 400;
    font-size: 12px;
  }
  .recipe-section .recipe-body { padding: 12px 0 8px 0; }
</style>
</head>
<body>

<header>
  <div class="kicker">Grant Thornton · FinOps Findings</div>
  <h1>{{ client_name }}</h1>
  <div class="subtitle">
    Cost optimization analysis · generated {{ generated_at }} · Schema v{{ schema_version }}
  </div>
</header>

<main>

<!-- Headline numbers -->
<section>
  <h2>Headline numbers</h2>
  <div class="headline-grid">
    <div class="stat-card">
      <div class="stat-label">Total findings</div>
      <div class="stat-value">{{ summary.total_findings }}</div>
      <div class="stat-sub">across {{ summary.by_recipe | length }} recipes</div>
    </div>
    <div class="stat-card orange">
      <div class="stat-label">Gross annual savings</div>
      <div class="stat-value">${{ "{:,.0f}".format(summary.total_gross_usd) }}</div>
      <div class="stat-sub">if every finding implemented</div>
    </div>
    <div class="stat-card teal">
      <div class="stat-label">Capturable annual savings</div>
      <div class="stat-value">${{ "{:,.0f}".format(summary.total_capturable_usd) }}</div>
      <div class="stat-sub">realistic capture estimate</div>
    </div>
  </div>

  <div class="callout">
    <div class="callout-label">House rule</div>
    <div class="callout-body">
      The capturable estimate is the number GT reports to the client. Gross assumes
      100% implementation of every finding. Capturable accounts for BU review, edge
      cases, and adoption realities. Underclaim by default — it builds credit.
    </div>
  </div>
</section>

<!-- Category summary -->
<section>
  <h2>Savings by category</h2>
  <table>
    <thead>
      <tr>
        <th>Category</th>
        <th class="num">Findings</th>
        <th class="num">Gross annual</th>
        <th class="num">Capturable annual</th>
      </tr>
    </thead>
    <tbody>
    {% for cat, stats in summary.by_category.items() %}
      <tr>
        <td><span class="pill {{ cat.lower() }}">{{ cat }}</span></td>
        <td class="num">{{ stats.count }}</td>
        <td class="num">${{ "{:,.0f}".format(stats.gross) }}</td>
        <td class="num"><strong>${{ "{:,.0f}".format(stats.capturable) }}</strong></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</section>

<!-- Recipe-by-recipe breakdown -->
<section>
  <h2>Breakdown by recipe</h2>
  <table>
    <thead>
      <tr>
        <th>Recipe</th>
        <th>Name</th>
        <th class="num">Findings</th>
        <th class="num">Capturable annual</th>
      </tr>
    </thead>
    <tbody>
    {% for recipe_id, stats in summary.by_recipe.items() %}
      <tr>
        <td>{{ recipe_id }}</td>
        <td>{{ stats.name }}</td>
        <td class="num">{{ stats.count }}</td>
        <td class="num"><strong>${{ "{:,.0f}".format(stats.capturable) }}</strong></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</section>

<!-- Top findings -->
<section>
  <h2>Top {{ top_findings | length }} findings by capturable savings</h2>
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Recipe</th>
        <th>Category</th>
        <th>Entity</th>
        <th>Recommendation</th>
        <th class="num">Capturable annual</th>
        <th>Confidence</th>
      </tr>
    </thead>
    <tbody>
    {% for row in top_findings %}
      <tr>
        <td>{{ loop.index }}</td>
        <td>{{ row.recipe_id }}</td>
        <td><span class="pill {{ row.category.lower() }}">{{ row.category }}</span></td>
        <td>{{ row.entity_name[:60] }}</td>
        <td>{{ row.recommended_state[:80] }}</td>
        <td class="num"><strong>${{ "{:,.0f}".format(row.capturable_annual_savings_usd) }}</strong></td>
        <td><span class="pill {{ row.confidence.lower() }}">{{ row.confidence }}</span></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</section>

<!-- Per-recipe detail -->
<section>
  <h2>Per-recipe detail</h2>
  {% for recipe_id, stats in summary.by_recipe.items() %}
    <details class="recipe-section">
      <summary>
        {{ recipe_id }} · {{ stats.name }}
        <span class="recipe-stats">
          {{ stats.count }} findings · ${{ "{:,.0f}".format(stats.capturable) }} capturable
        </span>
      </summary>
      <div class="recipe-body">
      {% if recipe_findings.get(recipe_id) is defined and recipe_findings[recipe_id] | length > 0 %}
        <table>
          <thead>
            <tr>
              <th>Entity</th>
              <th>Current state</th>
              <th>Recommendation</th>
              <th class="num">Gross</th>
              <th class="num">Capturable</th>
              <th>Confidence</th>
            </tr>
          </thead>
          <tbody>
          {% for row in recipe_findings[recipe_id][:15] %}
            <tr>
              <td>{{ row.entity_name[:50] }}</td>
              <td>{{ row.current_state[:70] }}</td>
              <td>{{ row.recommended_state[:70] }}</td>
              <td class="num">${{ "{:,.0f}".format(row.gross_annual_savings_usd) }}</td>
              <td class="num"><strong>${{ "{:,.0f}".format(row.capturable_annual_savings_usd) }}</strong></td>
              <td><span class="pill {{ row.confidence.lower() }}">{{ row.confidence }}</span></td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
        {% if recipe_findings[recipe_id] | length > 15 %}
          <p style="color: var(--text-muted); font-size: 12px;">
            Showing top 15 of {{ recipe_findings[recipe_id] | length }}.
            Full list in the Excel workbook (tab: {{ recipe_id }}).
          </p>
        {% endif %}
      {% else %}
        <p style="color: var(--text-muted); padding: 12px 18px;">No findings for this recipe.</p>
      {% endif %}
      </div>
    </details>
  {% endfor %}
</section>

</main>

<footer>
  Grant Thornton · FinOps Quick-Wins Analyzer v{{ version }} · For internal consulting use only
</footer>

</body>
</html>
